# Copy to .env and adjust. Every setting is optional.
VOIDGRID_BRAND_NAME=VoidGrid
VOIDGRID_DATABASE_URL=sqlite:///./voidgrid.db
# VOIDGRID_DATABASE_URL=postgresql+psycopg://voidgrid:voidgrid@localhost:5432/voidgrid

# Who this MCP server acts as (one person per server process)
VOIDGRID_USER_HANDLE=me

# scripted (offline) or anthropic (needs ANTHROPIC_API_KEY)
VOIDGRID_LLM_PROVIDER=scripted
VOIDGRID_ANTHROPIC_MODEL=claude-opus-5-5
VOIDGRID_ANTHROPIC_EFFORT=low
VOIDGRID_DAILY_TURN_BUDGET_PER_LOUNGE=200

# Public address of the VIP link page
VOIDGRID_WEB_BASE_URL=http://127.0.0.1:8000

# Pull Wikipedia's daily featured feed (CC BY-SA 4.0)
VOIDGRID_ENABLE_WIKIPEDIA_SOURCE=false

# The scout (curated feeds + Hacker News buzz + diamond score) and briefings (real comments + facts).
# Off by default for the MCP server and tests; voidgrid-ui turns both on unless you set them here.
# VOIDGRID_ENABLE_SCOUT=true
# VOIDGRID_ENABLE_BRIEFINGS=true
# VOIDGRID_SCOUT_LLM_SCORING=true   # with the anthropic provider, Claude judges each find

# The owner's web UI (local only, no login)
VOIDGRID_UI_PORT=8010
